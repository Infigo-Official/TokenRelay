# Legacy OpenSSL config for TokenRelay containers that must reach OLD TLS servers
# (e.g. legacy IIS/Schannel CERM box that fails with "sslv3 alert handshake failure").
#
# .NET on Linux uses the system OpenSSL, which honors OPENSSL_CONF. Point OPENSSL_CONF
# at this file to lower the security level so old protocols/ciphers/signatures are allowed.
#
# This file is baked into the image at /app/openssl-legacy.cnf and is only activated when
# the container is started with TLS_LEGACY_MODE=true (entrypoint sets OPENSSL_CONF for you).
#
# SECURITY: this weakens TLS for the WHOLE process. Only use on a dedicated proxy box
# whose job is to reach legacy endpoints. Do NOT enable as the default.
#
# Enable in docker-compose:
#   environment:
#     - TLS_LEGACY_MODE=true

# This config fully REPLACES the system openssl.cnf when OPENSSL_CONF points here, so it
# must load the default provider itself (otherwise no crypto algorithms are available).
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_configuration

# Load the default OpenSSL provider (needed for standard TLS since we replaced system config)
[provider_sect]
default = default_sect

[default_sect]
activate = 1

[ssl_configuration]
system_default = tls_system_default

[tls_system_default]
# Allow TLS 1.0 and up (default is TLS 1.2)
MinProtocol = TLSv1
# SECLEVEL=0 permits SHA1 signatures, small RSA/DH keys, and legacy cipher suites
CipherString = DEFAULT@SECLEVEL=0
